-- Schema and queries. SQLDelight generates type-safe Kotlin from this file.
-- The table generates a `Flashcard` data class in the com.mochi.db package.

CREATE TABLE flashcard (
    id               INTEGER PRIMARY KEY AUTOINCREMENT,
    front            TEXT NOT NULL,          -- Word (e.g. 私)
    back             TEXT NOT NULL,          -- Word meaning (e.g. I (polite, general))
    reading          TEXT NOT NULL,          -- Kana reading (e.g. わたし)
    category         TEXT NOT NULL,          -- e.g. "Kaishi 1.5k"
    sentence         TEXT,                   -- example sentence
    sentence_meaning TEXT,                   -- sentence translation
    audio            TEXT,                   -- audio file name (optional)
    frequency        INTEGER NOT NULL DEFAULT 0,

    -- Spaced-repetition state (to grow into an Anki-style SRS later):
    next_review      INTEGER,                -- epoch millis; NULL = never reviewed
    interval_days    INTEGER NOT NULL DEFAULT 0,
    ease             REAL    NOT NULL DEFAULT 2.5
);

countCards:
SELECT COUNT(*) FROM flashcard;

insertCard:
INSERT INTO flashcard(front, back, reading, category, sentence, sentence_meaning, audio, frequency)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM flashcard ORDER BY frequency ASC;

selectDueForReview:
SELECT * FROM flashcard
WHERE next_review IS NULL OR next_review <= :now
ORDER BY next_review ASC, frequency ASC;

-- How many cards have been started (used for the "learned" stat).
countStarted:
SELECT COUNT(*) FROM flashcard WHERE next_review IS NOT NULL;

updateReview:
UPDATE flashcard
SET next_review = :nextReview, interval_days = :intervalDays, ease = :ease
WHERE id = :id;
