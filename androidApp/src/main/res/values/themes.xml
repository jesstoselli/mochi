<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- windowBackground is what the system draws during cold start (the "splash"). It points
         at a color with a values-night variant, so it follows the system light/dark setting. -->
    <style name="Theme.Mochi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>